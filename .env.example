OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
SYSTEM_PROMPT=You are a helpful personal assistant.
# Shared answer-provider cooldown after a rate limit (seconds; 0 disables).
LLM_RATE_LIMIT_COOLDOWN_SECONDS=30
# Default: all test-email workers must share this restart-persistent file.
TEST_ALERT_ATTEMPTS_BACKEND=sqlite
TEST_ALERT_ATTEMPTS_PATH=logs/test_alert_attempts.sqlite3
# For independent disks, explicitly select postgres and configure this as a secret.
# Apply scripts/test_alert_attempts_schema.sql and import old claims first.
# TEST_ALERT_ATTEMPTS_DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require