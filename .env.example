OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
SYSTEM_PROMPT=You are a helpful personal assistant.
# Shared answer-provider cooldown after a rate limit (seconds; 0 disables).
LLM_RATE_LIMIT_COOLDOWN_SECONDS=30
# Default: all test-email workers must share this restart-persistent file.
TEST_ALERT_ATTEMPTS_BACKEND=sqlite
TEST_ALERT_ATTEMPTS_PATH=logs/test_alert_attempts.sqlite3
# For independent disks, explicitly select postgres and configure this as a secret.
# Apply scripts/test_alert_attempts_schema.sql and import old claims first.
# TEST_ALERT_ATTEMPTS_DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Optional read-only operator quota snapshot. No quota is inferred from statvfs.
# Use the quota covering backup review storage, and ALL usage charged against it.
# Integer bytes: limit > 0, usage >= 0 (usage may exceed the limit).
# Measurement requires an ISO-8601 timezone; stale (>24h) or future data is unavailable.
# Optional file is reread on admin reload (see docs/BACKUP_STORAGE_QUOTA.md).
# When configured, file failures show unavailable; no environment fallback.
# Publish atomically using an external operator job, not the admin server.
# BACKUP_STORAGE_QUOTA_SNAPSHOT_PATH=/operator-managed/backup-quota.json
# Without a snapshot path, refresh these values and restart the admin server.
# BACKUP_STORAGE_QUOTA_LIMIT_BYTES=
# BACKUP_STORAGE_QUOTA_USED_BYTES=
# BACKUP_STORAGE_QUOTA_MEASURED_AT=